{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "env": {
    "NEXT_PUBLIC_API_URL": "@next_public_api_url"
  },
  "regions": ["sfo1"],
  "functions": {
    "frontend/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
